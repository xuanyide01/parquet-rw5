<template>
  <div class="page" onswipe="swipe">
    <image class="system-backdrop" src="/common/ui/system.png"></image>
    <div if="{{mode === 'title'}}" class="title-screen">
      <image class="title-art" src="{{titleBackgroundSrc}}" onerror="titleBackgroundError" oncomplete="titleBackgroundLoaded"></image>
      <image class="title-logo" src="/common/ui/title-logo.png"></image>
      <div class="title-menu">
        <div if="{{afterUnlocked}}" class="title-row" onclick="startAfterStory"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-after.png"></image></div>
        <div class="title-row" onclick="startNew"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-start.png"></image></div>
        <div class="title-row" onclick="startSideStory"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-side.png"></image></div>
        <div class="title-row" onclick="openChapterRoutes"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-chapter.png"></image></div>
        <div class="title-row" onclick="continueGame"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-load.png"></image></div>
        <div class="title-row" onclick="openSettings"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-config.png"></image></div>
        <div class="title-row" onclick="openGallery"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-extra.png"></image></div>
        <div class="title-row" onclick="exitApplication"><image class="title-button" src="/common/ui/title-button.png"></image><image class="title-label" src="/common/ui/title-exit.png"></image></div>
      </div>
      <text class="title-footer">PARQUET</text>
    </div>
    <div if="{{mode === 'play'}}" class="art" onclick="advance">
      <image class="art-fill" src="/common/ui/art-fill.png"></image>
      <image class="background" style="top: {{sceneArtTop}}px; height: {{sceneArtHeight}}px;" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{bodySrc !== ''}}" class="body" style="width: {{portraitWidth}}px; height: {{portraitHeight}}px; top: {{portraitTop}}px; left: {{portraitLeft}}px;" src="{{bodySrc}}"></image>
      <image if="{{faceSrc !== ''}}" class="body" style="width: {{portraitWidth}}px; height: {{portraitHeight}}px; top: {{portraitTop}}px; left: {{portraitLeft}}px;" src="{{faceSrc}}"></image>
      <image if="{{bodySecond !== ''}}" class="body" style="width: {{portraitSecondWidth}}px; height: {{portraitSecondHeight}}px; top: {{portraitSecondTop}}px; left: {{portraitSecondLeft}}px;" src="{{bodySecond}}"></image>
      <image if="{{faceSecondSrc !== ''}}" class="body" style="width: {{portraitSecondWidth}}px; height: {{portraitSecondHeight}}px; top: {{portraitSecondTop}}px; left: {{portraitSecondLeft}}px;" src="{{faceSecondSrc}}"></image>
      <image if="{{bodyThird !== ''}}" class="body" style="width: {{portraitThirdWidth}}px; height: {{portraitThirdHeight}}px; top: {{portraitThirdTop}}px; left: {{portraitThirdLeft}}px;" src="{{bodyThird}}"></image>
      <image if="{{faceThirdSrc !== ''}}" class="body" style="width: {{portraitThirdWidth}}px; height: {{portraitThirdHeight}}px; top: {{portraitThirdTop}}px; left: {{portraitThirdLeft}}px;" src="{{faceThirdSrc}}"></image>
      <image if="{{cutInSrc !== ''}}" class="cutin-shade" style="opacity: {{cutInOpacity}};" src="/common/ui/cutin-shade.png"></image>
      <image if="{{cutInSrc !== ''}}" class="cutin-portrait" style="width: {{cutInWidth}}px; left: {{cutInLeft}}px;" src="{{cutInSrc}}"></image>
      <image if="{{cutInSrc !== ''}}" class="cutin-shade" src="/common/ui/cutin-frame.png"></image>
      <image if="{{anotherView}}" class="another-banner" src="/common/ui/another-banner.png"></image>
    </div>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <image class="dialogue-frame" src="{{dialogueFrameSrc}}"></image>
      <div class="speaker-row"><text class="speaker" style="font-family: {{speakerFont}};">{{speaker}}</text><text class="chapter" style="font-family: {{chapterFont}};">{{chapterLabel}}</text></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" onscroll="dialogueScrolled" onclick="dialogueTap"><text class="dialogue" style="font-size: {{fontSize}}px;font-family: {{dialogueFont}};">{{displayText}}</text></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <text class="choice-title">选择下一步</text>
      <scroll class="choice-list" scroll-y="true"><div for="{{options}}" tid="text" class="choice-row" onclick="pick($idx)"><image class="choice-surface" src="/common/ui/choice-card.png"></image><text class="choice" style="font-family: {{$item.font}};">{{$item.text}}</text></div></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay reading-menu">
      <text class="quick-title">QUICK MENU</text><text class="quick-subtitle">阅读控制</text>
      <div class="quick-grid">
        <div class="quick-row">
          <div class="quick-cell" onclick="saveGame"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">保存进度</text></div>
          <div class="quick-cell" onclick="loadGame"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">读取进度</text></div>
        </div>
        <div class="quick-row">
          <div class="quick-cell" onclick="goNextChapter"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">下一章 ›</text></div>
          <div class="quick-cell" onclick="toggleAuto"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">{{autoLabel}}</text></div>
        </div>
        <div class="quick-row">
          <div class="quick-cell" onclick="cycleAutoSpeed"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">{{autoSpeedLabel}}</text></div>
          <div class="quick-cell" onclick="toggleSpeed"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">{{speedLabel}}</text></div>
        </div>
        <div class="quick-row">
          <div class="quick-cell" onclick="toggleFont"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">{{fontLabel}}</text></div>
          <div class="quick-cell" onclick="openSettings"><image class="quick-card" src="/common/ui/quick-card.png"></image><text class="quick-action">系统设置</text></div>
        </div>
      </div>
      <text class="menu-action quick-resume" onclick="resume">返回游戏</text>
      <text class="menu-action quick-title-return muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'settings'}}" class="overlay settings-panel">
      <text class="settings-title">System</text><text class="settings-subtitle">阅读显示与标题背景</text>
      <text class="menu-action settings-speed" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action settings-font" onclick="toggleFont">{{fontLabel}}</text>
      <text class="background-heading">TITLE BACKGROUND</text><text class="background-description">后日谈通关后解锁对应背景</text>
      <div class="background-row">
        <div for="{{titleBackgroundRows}}" tid="key" class="background-card" style="border-color: {{$item.selected ? '#67eff5' : '#25434b'}};" onclick="selectTitleBackground($item.index)">
          <image class="background-preview" src="{{$item.thumbnailSrc}}"></image><image if="{{$item.selected}}" class="background-selection" src="/common/ui/background-selected.png"></image>
          <text class="background-name" style="color: {{$item.unlocked ? '#ffffff' : '#70858b'}};">{{$item.label}}</text>
          <text class="background-state" style="color: {{$item.selected ? '#67eff5' : '#8ea3a9'}};">{{$item.stateLabel}}</text>
        </div>
      </div>
      <text class="background-hint">{{titleBackgroundHint}}</text>
      <text class="menu-action settings-return muted" onclick="closeSettings">{{settingsReturnLabel}}</text>
    </div>
    <div if="{{mode === 'routes' || mode === 'chapters'}}" class="full-panel">
      <text class="panel-title">{{browseTitle}}</text><text class="panel-subtitle" style="font-family: {{browseFont}};">{{browseLabel}}</text>
      <div class="slot-list"><div for="{{browseRows}}" tid="key" class="slot-card" onclick="selectBrowse($idx)"><text class="slot-title" style="font-family: {{$item.font}};">{{$item.name}}</text><text class="slot-meta">{{$item.detail}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousBrowse">‹ 上一页</text><text class="pager-action" onclick="closeBrowse">返回</text><text class="pager-action" onclick="nextBrowse">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#102b36' : '#07131b'}};" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><text class="slot-meta" style="font-family: {{$item.metaFont}};">{{$item.meta}}</text><text class="slot-preview" style="font-family: {{$item.previewFont}};">{{$item.preview}}</text>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <text class="confirm-text" style="font-family: {{overwriteFont}};">{{overwriteDetail}}</text>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption" style="font-family: {{cgFont}};">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">{{endingLabel}}</text><text class="subtitle">故事阅读完毕</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {newState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous,previewMap} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,createSave,slotRow} from '../../common/saves.js';
import {chapterLabel} from '../../common/chapter-label.js';
import {catalog} from '../../common/catalog.js';
import {imagePath} from '../../common/assets.js';
import {groupGallery,stepVariant} from '../../common/gallery.js';
import {textFont} from '../../common/text-font.js';
import {cutInBox} from '../../common/cutin-layout.js';
import {portraitBox} from '../../common/portrait-layout.js';
import {PROGRESS_KEY,emptyProgress,decodeProgress,progressFromState,withProgress} from '../../common/progress.js';
import {titleBackgroundDefinitions,titleBackgroundStatus,resolveTitleBackground} from '../../common/title-background.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
export default {
  private:{anotherView:false,sceneArtTop:0,sceneArtHeight:286,cutInSrc:'',cutInWidth:240,cutInLeft:96,cutInOpacity:0.8,titleBackgroundIndex:0,titleBackgroundSrc:'/common/ui/title-0.jpg',titleBackgroundRows:[],titleBackgroundHint:'默认背景始终可用',settingsReturnLabel:'返回标题',dialogueFrameSrc:'/common/ui/dialogue.png',faceThirdSrc:'',faceThirdWidth:0,faceThirdHeight:0,faceThirdTop:0,faceThirdLeft:0,faceSecondSrc:'',faceSecondWidth:0,faceSecondHeight:0,faceSecondTop:0,faceSecondLeft:0,faceSrc:'',faceWidth:0,faceHeight:0,faceTop:0,faceLeft:0,mode:'title',backgroundSrc:'/common/ui/title.jpg',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:200,portraitLeft:116,portraitSecondLeft:216,speaker:'',displayText:'',chapterLabel:'',speakerFont:'parquetextra',dialogueFont:'parquetextra',chapterFont:'parquetextra',browseFont:'parquetextra',overwriteFont:'parquetextra',cgFont:'parquetextra',
    options:[],loading:false,errorText:'',hasNextChapter:true,afterUnlocked:false,fontSize:24,textSpeed:30,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',speedLabel:'显示速度：逐字',fontLabel:'字号：标准',progressLabel:'红米手表 5 · 图文版',
    portraitHeight:286,portraitTop:0,portraitSecondWidth:200,portraitSecondHeight:286,portraitSecondTop:0,portraitThirdWidth:144,portraitThirdHeight:286,portraitThirdTop:0,portraitThirdLeft:288,
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',endingLabel:'本篇阅读完毕',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:'',browseRows:[],browseTitle:'',browseLabel:'',browsePage:0},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this.loadSequence=0;this.timer=null;this._autoTimer=null;this._autoGeneration=0;this.autoEnabled=false;this._touchReading=false;this._needsFrame=false;this.fullText='';this.resumeMode='play';
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=[];this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    this._settingsReady=false;this._settingsReturnMode='title';this._progress=emptyProgress();this._progressWriteBusy=false;this._progressDirty=false;this._progressReady=false;this.loading=true;
    storage.get({complete:()=>{},key:'parquet_rw5_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===0?0:30;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.titleBackgroundIndex=Number.isInteger(s.titleBackgroundIndex)&&s.titleBackgroundIndex>=0&&s.titleBackgroundIndex<3?s.titleBackgroundIndex:0;}catch(e){}this._settingsReady=true;this.refreshSettings();this.refreshTitleBackground();},fail:()=>{this._settingsReady=true;this.refreshSettings();this.refreshTitleBackground();}});
    this.readProgress();
    console.log('PARQUET_RW5 title ready');
  },
  titleBackgroundLoaded(){console.log('PARQUET_RW5 background loaded title',this.titleBackgroundSrc);},
  titleBackgroundError(){console.log('PARQUET_RW5 background failed title',this.titleBackgroundSrc);},
  backgroundLoaded(){console.log('PARQUET_RW5 background loaded',this.mode,this.backgroundSrc);},
  backgroundError(){console.log('PARQUET_RW5 background failed',this.mode,this.backgroundSrc);},
  clearTyping(){this.clearAuto();if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  armAuto(){
    this.clearAuto();if(!this.autoEnabled||this._hidden||this._touchReading||this._needsFrame||this.loading||this.storageBusy||this.mode!=='play'||this.displayText!==this.fullText)return;
    const generation=this._autoGeneration,chapter=this.session.chapter,cursor=this.session.cursor;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.autoEnabled||this._hidden||this._touchReading||this.loading||this.storageBusy||this.mode!=='play'||this.session.chapter!==chapter||this.session.cursor!==cursor)return;console.log('PARQUET_RW5 auto advance',chapter,cursor);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('PARQUET_RW5 auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('PARQUET_RW5 auto speed',this.autoSpeed);},
  onShow(){this._hidden=false;if(this._needsFrame||(this._chapterSkip&&this.timer===null))this.renderFrame();else this.armAuto();},
  onHide(){this._hidden=true;this._touchReading=false;this.clearTyping();if(!this._chapterSkip&&this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this._needsFrame=false;this.stopAuto();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;},
  readProgress(){this.loading=true;storage.get({complete:()=>{},key:PROGRESS_KEY,default:'',success:data=>{try{this._progress=decodeProgress(data);this._progressReady=true;this.refreshProgress();this.loading=false;}catch(e){this.fail(e.message);}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');}});},
  startAfterStory(){if(this.loading||!this._progressReady)return;if(!this.afterUnlocked){this.toast('请先完成正篇');return;}this.clearTyping();this._chapterSkip=null;this.session=withProgress(newState(catalog.afterInitial,true),this._progress);this.cachedChapter=0;this._autoHops=0;console.log('PARQUET_RW5 after story start');this.renderFrame();},
  openSettings(){if(this.loading)return;this.clearTyping();this._settingsReturnMode=this.mode==='menu'?'menu':'title';this.settingsReturnLabel=this._settingsReturnMode==='menu'?'返回菜单':'返回标题';this.refreshSettings();this.refreshTitleBackground();this.mode='settings';console.log('PARQUET_RW5 settings open',this._settingsReturnMode);},
  closeSettings(){this.refreshTitleBackground();if(this._settingsReturnMode==='menu'){this.mode='menu';return;}this.toTitle();},
  refreshTitleBackground(){
    const variables=this._progress?this._progress.variables:{},index=resolveTitleBackground(this.titleBackgroundIndex,variables);
    this.titleBackgroundSrc=titleBackgroundDefinitions[index].source;
    this.titleBackgroundRows=titleBackgroundStatus(variables).map(d=>Object.assign({},d,{key:'background:'+d.index+':'+(d.index===index?1:0)+':'+(d.unlocked?1:0),selected:d.index===index,thumbnailSrc:d.unlocked?d.thumbnail:'/common/ui/title-locked.png',stateLabel:d.index===index?'使用中':d.unlocked?'点击使用':'未解锁'}));
    this.titleBackgroundHint='当前：'+titleBackgroundDefinitions[index].label+'背景';console.log('PARQUET_RW5 title backgrounds',this.titleBackgroundRows.map(d=>d.unlocked?1:0).join(','),index);
  },
  selectTitleBackground(index){
    if(this.loading||!this._progressReady||!Number.isInteger(index)||index<0||index>2)return;
    const row=titleBackgroundStatus(this._progress.variables)[index];if(!row.unlocked){this.titleBackgroundHint=row.requirement;this.toast(row.requirement);console.log('PARQUET_RW5 title background locked',index);return;}
    this.titleBackgroundIndex=index;this.refreshTitleBackground();this.persistSettings();this.toast('已切换为'+row.label+'背景');console.log('PARQUET_RW5 title background selected',index);
  },
  exitApplication(){this._needsFrame=false;this.stopAuto();this._chapterSkip=null;this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.$app.exit();},
  startSideStory(){if(this.loading||!this._progressReady)return;this.clearTyping();this._chapterSkip=null;this.session=withProgress(newState(catalog.sideInitial,true),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  startNew(){if(this.loading||!this._progressReady)return;this.clearTyping();this._chapterSkip=null;this.session=withProgress(newState(this._progress.variables['sf.parquet_side_clear']?catalog.flowScene:catalog.sideInitial,true),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  refreshProgress(){this.progressLabel='红米手表 5 · 图文版';this.afterUnlocked=!!this._progress.variables['sf.parquet_main_clear'];this.refreshTitleBackground();},
  syncProgress(){
    if(!this._progressReady||this.session.progression!=='story')return;const progress=progressFromState(this.session);
    if(JSON.stringify(progress)===JSON.stringify(this._progress))return;
    this._progress=progress;this._progressDirty=true;this.refreshProgress();this.writeProgress();
  },
  writeProgress(){
    if(this._progressWriteBusy||!this._progressDirty)return;this._progressWriteBusy=true;this._progressDirty=false;
    const payload=JSON.stringify(this._progress);
    storage.set({complete:()=>{},key:PROGRESS_KEY,value:payload,success:()=>{this._progressWriteBusy=false;this.writeProgress();},fail:()=>{this._progressWriteBusy=false;this._progressDirty=true;this.toast('通关记录保存失败，请重试保存或返回标题');}});
  },
  openChapterRoutes(){if(this.loading)return;this.clearTyping();this._browseFromRoutes=true;this._browseRoute=0;this.mode='routes';this.browsePage=0;this.refreshBrowse();},
  openRoutes(){if(this.loading)return;this.clearTyping();this._browseFromRoutes=false;this._browseRoute=0;this.mode='chapters';this.browsePage=0;this.refreshBrowse();},
  visibleText(text){return String(text||'').replace(/・/g,'·').replace(/\uFFFC/g,'');},
  characterName(name){return name;},
  visibleOptions(items){return items.map(item=>{const text=this.visibleText(item.text);return Object.assign({},item,{text,font:textFont(text)});});},
  refreshBrowse(){const routes=this.mode==='routes';this._browseItems=routes?(this.afterUnlocked?catalog.routes:catalog.routes.slice(0,2)):catalog.chapters.filter(x=>x.route===this._browseRoute);this.browseTitle=routes?'选择路线':'选择章节';const start=this.browsePage*4;this.browseRows=this._browseItems.slice(start,start+4).map((item,i)=>({key:(routes?'route:':'chapter:'+this._browseRoute+':')+(start+i),index:start+i,name:this.visibleText(item.name),font:textFont(item.name),detail:routes?item.scenes.length+' 个章节':'点击开始阅读'}));this.browseLabel=(routes?'章节阅读 · ':this.visibleText(catalog.routes[this._browseRoute].name)+' · ')+(this.browsePage+1)+' / '+Math.ceil(this._browseItems.length/4);this.browseFont=textFont(this.browseLabel);},
  previousBrowse(){if(this.browsePage>0){this.browsePage--;this.refreshBrowse();}},
  nextBrowse(){if(this.browsePage<Math.ceil(this._browseItems.length/4)-1){this.browsePage++;this.refreshBrowse();}},
  selectBrowse(row){const index=this.browsePage*4+row;if(!this._browseItems[index])return;if(this.mode==='routes'){this._browseRoute=index;this.browsePage=0;this.mode='chapters';this.refreshBrowse();return;}const item=this._browseItems[index];this.session=withProgress(newState(item.id),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  closeBrowse(){if(this.mode==='chapters'&&this._browseFromRoutes){this.mode='routes';this.browsePage=0;this.refreshBrowse();return;}this.toTitle();},
  continueGame(){this.openSlots('load');},
  readChapter(chapter,done){
    const block=Math.floor(this.session.cursor/32),key=chapter+':'+block;
    if(this.cachedChapter===key){done();return;}
    this.loading=true;const seq=++this.loadSequence;
    file.readText({complete:()=>{},uri:'/common/story/'+chapter+'/'+block+'.txt',success:data=>{
      if(seq!==this.loadSequence)return;
      try{const ops=JSON.parse(data.text);if(!Array.isArray(ops))throw new Error('章节格式无效');this.ops=ops;this.opsBase=block*32;this.cachedChapter=key;this.loading=!!this._chapterSkip;done();}
      catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this.loadSequence)this.fail('第 '+chapter+' 章读取失败：'+code+' '+String(data||'').slice(0,100));}});
  },
  renderFrame(){
    this._needsFrame=true;this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        const f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip,this.opsBase,catalog.scenes[String(this.session.chapter)].length):readFrame(this.ops,this.session,this.opsBase,catalog.scenes[String(this.session.chapter)].length);
        this.syncProgress();
        if(f.type==='jump'||f.type==='yield'){this._autoHops=(this._autoHops||0)+1;if(this._autoHops>1000)throw new Error('此章节无法继续，故事阅读完毕');this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}this._autoHops=0;this._chapterSkip=null;this.loading=false;
        this._needsFrame=false;this.backgroundSrc=imagePath(this.session.background);this.anotherView=this.session.view==='another';this.sceneArtTop=this.anotherView?24:0;this.sceneArtHeight=286-this.sceneArtTop;const cut=cutInBox(this.session.cutIn);this.cutInSrc=cut.src;this.cutInWidth=cut.width;this.cutInLeft=cut.left;this.cutInOpacity=Math.min(1,Math.max(0,(this.session.cutInOpacity||0)/255));console.log('PARQUET_RW5 scene visual',this.session.chapter,this.session.cursor,this.session.view||'normal',this.session.cutIn||'none');
        const bodies=this.session.bodies||[];this.bodySrc=bodies[0]?imagePath(bodies[0]):'';this.bodySecond=bodies[1]?imagePath(bodies[1]):'';this.bodyThird=bodies[2]?imagePath(bodies[2]):'';
        const first=portraitBox(bodies[0],bodies.length,0,this.sceneArtTop),second=portraitBox(bodies[1],bodies.length,1,this.sceneArtTop),third=portraitBox(bodies[2],bodies.length,2,this.sceneArtTop);
        this.portraitWidth=first.width;this.portraitHeight=first.height;this.portraitTop=first.top;this.portraitLeft=first.left;
        this.portraitSecondWidth=second.width;this.portraitSecondHeight=second.height;this.portraitSecondTop=second.top;this.portraitSecondLeft=second.left;
        this.portraitThirdWidth=third.width;this.portraitThirdHeight=third.height;this.portraitThirdTop=third.top;this.portraitThirdLeft=third.left;
        this.faceSrc=first.patch;this.faceWidth=first.patchWidth;this.faceHeight=first.patchHeight;this.faceLeft=first.patchLeft;this.faceTop=first.patchTop;
        this.faceSecondSrc=second.patch;this.faceSecondWidth=second.patchWidth;this.faceSecondHeight=second.patchHeight;this.faceSecondLeft=second.patchLeft;this.faceSecondTop=second.patchTop;
        this.faceThirdSrc=third.patch;this.faceThirdWidth=third.patchWidth;this.faceThirdHeight=third.patchHeight;this.faceThirdLeft=third.patchLeft;this.faceThirdTop=third.patchTop;
        this.dialogueFrameSrc=(this.anotherView||catalog.scenes[String(this.session.chapter)].route===0)?'/common/ui/dialogue-side.png':'/common/ui/dialogue.png';
        this.chapterLabel=this.visibleText(chapterLabel(this.session));this.chapterFont=textFont(this.chapterLabel);this.hasNextChapter=!this.session.ended;
        if(f.type==='map'){this.renderMap(f);return;}
        if(f.type==='choice'){this.options=this.visibleOptions(f.items);this.mode='choice';console.log('PARQUET_RW5 choice',this.session.chapter,this.session.cursor);return;}
        if(f.type==='end'){this.stopAuto();if(this.session.progression==='story'){const flag=catalog.scenes[String(this.session.chapter)].clearFlag;if(flag){this.session.variables[flag]=true;this.syncProgress();const background=titleBackgroundDefinitions.filter(d=>d.flag===flag)[0];if(background){this.titleBackgroundIndex=background.index;this.refreshTitleBackground();this.persistSettings();console.log('PARQUET_RW5 ending background selected',background.index);}}}this.endingLabel=(catalog.endings[String(this.session.chapter)]||'本篇')+' · 阅读完毕';console.log('PARQUET_RW5 ending',this.session.chapter,this.endingLabel);this.toTitle();return;}
        this.mode='play';this.speaker=this.characterName(this.visibleText(f.speaker));this.fullText=this.visibleText(f.text).replace(/(^|\n)[ \t\u3000]{3,}/g,'$1');this.speakerFont=textFont(this.speaker);this.dialogueFont=textFont(this.fullText);this.displayText='';
        this._dialogueDragged=false;this._dialogueTouch=null;
        try{this.$element('dialogue-scroll').scrollTo({top:0,behavior:'instant'});}catch(e){}
        console.log('PARQUET_RW5 frame',this.session.chapter,this.session.cursor);
        const speed=this.textSpeed||(this.autoEnabled?30:0);if(speed===0){this.displayText=this.fullText;this.armAuto();return;}
        const tick=()=>{this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else{this.timer=null;this.armAuto();}};tick();
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this._needsFrame||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;this.armAuto();return;}next(this.session);this.renderFrame();},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();const touch=event.touches&&event.touches[0];this._dialogueDragged=false;this._dialogueTouch=touch?{x:touch.pageX,y:touch.pageY}:null;},
  dialogueTouchMove(event){const touch=event.touches&&event.touches[0],start=this._dialogueTouch;if(touch&&start&&(Math.abs(touch.pageX-start.x)>10||Math.abs(touch.pageY-start.y)>10))this._dialogueDragged=true;},
  dialogueTouchEnd(){this._touchReading=false;this.armAuto();},
  dialogueTap(){if(this._dialogueDragged)return;this.advance();},
  dialogueScrolled(event){if(this.mode==='play')this.armAuto();console.log('PARQUET_RW5 dialogue scroll',this.session.chapter,this.session.cursor,event.scrollY);},
  renderMap(frame){this.loading=true;const seq=++this.loadSequence;file.readText({complete:()=>{},uri:'/common/map-preview.txt',success:data=>{if(seq!==this.loadSequence)return;try{const choices=previewMap(JSON.parse(data.text),this.session,frame);if(!choices.length)throw new Error('此地图阶段暂无支持的剧情选项，请返回标题选择其他篇章');this.options=this.visibleOptions(choices);this.mode='choice';this.loading=false;console.log('PARQUET_RW5 map ready',this.session.chapter,this.session.cursor,choices.map(x=>x.value).join(','));}catch(e){this.fail(e.message);}},fail:()=>{if(seq===this.loadSequence)this.fail('地图选项读取失败');}});},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('PARQUET_RW5 safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();this.clearTyping();if(previous(this.session)){if(this.session.progression==='story')withProgress(this.session,this._progress);this.renderFrame();}else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('PARQUET_RW5 menu',this.session.chapter);},
  resume(){this.mode=this.resumeMode;if(this.mode==='play')this.armAuto();},
  swipe(event){
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.writeProgress();this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.loading=true;
    const seq=++this._slotsSequence;this._slotData=Array(SLOT_COUNT).fill(null);
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('PARQUET_RW5 slots ready',role);};
    const finish=index=>{
      if(seq!==this._slotsSequence)return;
      if(index+1<SLOT_COUNT){setTimeout(()=>readSlot(index+1),0);return;}
      if(this._slotData[0]){ready();return;}
      storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSave(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});
    };
    const readSlot=i=>{if(seq!==this._slotsSequence)return;storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSave(data);}catch(e){this._slotData[i]={invalid:true};}finish(i);},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};finish(i);}});};
    readSlot(0);
  },
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows;this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.refreshSlotRows();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.refreshSlotRows();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this.loading=false;this.mode=this._slotsReturnMode;if(this.mode==='play')this.armAuto();},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT)return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      try{this.session=restore(saved.state);if(this.session.progression==='story')withProgress(this.session,this._progress);this.cachedChapter=0;this._slotsSequence++;this.renderFrame();console.log('PARQUET_RW5 slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.toast(e.message);}return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.overwriteFont=textFont(this.overwriteDetail);this.mode='overwrite';console.log('PARQUET_RW5 overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData[index]=payload;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;
      this.armAuto();this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('PARQUET_RW5 slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading)return;this.clearTyping();this.mode='gallery';
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.length;this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('PARQUET_RW5 gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,font:textFont(item.label+'张'),src:imagePath(item.image)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if(this.loading||index<0||index>=this._galleryCatalog.length)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=imagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');this.cgFont=textFont(this.cgLabel);console.log('PARQUET_RW5 cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';},
  refreshSettings(){this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+(autoSpeeds[this.autoSpeed]||'标准');},
  persistSettings(){storage.set({complete:()=>{},key:'parquet_rw5_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed,titleBackgroundIndex:this.titleBackgroundIndex}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===24?28:24;this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this._needsFrame=false;this.stopAuto();this._chapterSkip=null;this.syncProgress();this.writeProgress();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.loading=false;this.mode='title';this.refreshTitleBackground();console.log('PARQUET_RW5 title shown',resolveTitleBackground(this.titleBackgroundIndex,this._progress.variables));this.backgroundSrc='/common/ui/title.jpg';this.bodySrc='';this.bodySecond='';this.bodyThird='';if(!this._progressReady)this.readProgress();},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.loadSequence++;this._needsFrame=false;this.stopAuto();this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.errorText=message;console.error('PARQUET_RW5 error',message);}
}
</script>
<style>
@font-face {font-family:parquetextra;src:url('/common/parquet-extra.otf');}
text{font-family:parquetextra;}
.page{width:432px;height:514px;background-color:#02080d;flex-direction:column;}
.system-backdrop{width:432px;height:514px;}
.title-screen{position:absolute;top:0px;left:0px;width:432px;height:514px;}
.title-art{position:absolute;top:0px;left:0px;width:432px;height:514px;object-fit:cover;}
.title-logo{position:absolute;top:28px;left:24px;width:214px;height:77px;object-fit:contain;}
.title-menu{position:absolute;top:174px;left:24px;width:240px;height:296px;flex-direction:column;}
.title-row{height:36px;width:236px;justify-content:flex-start;align-items:center;}
.title-button{position:absolute;top:2px;left:0px;width:230px;height:32px;}
.title-label{position:absolute;top:4px;left:30px;height:28px;width:202px;object-fit:contain;}
.title-footer{position:absolute;top:476px;left:48px;height:16px;width:336px;font-size:10px;color:#8ad2d9;text-align:left;}
.art{position:absolute;top:0px;left:0px;width:432px;height:286px;justify-content:center;align-items:center;background-color:#02080d;}
.art-fill{position:absolute;top:0px;left:0px;width:432px;height:286px;}
.background{position:absolute;top:0px;left:0px;width:432px;height:286px;object-fit:contain;}
.another-banner{position:absolute;top:0px;left:0px;width:432px;height:24px;}
.cutin-shade{position:absolute;top:0px;left:0px;width:432px;height:286px;}
.cutin-portrait{position:absolute;top:51px;left:96px;width:240px;height:206px;object-fit:contain;}
.body{position:absolute;top:0px;left:116px;width:200px;height:286px;object-fit:contain;}
.dialogue-panel{position:absolute;top:286px;left:0px;width:432px;height:228px;flex-direction:column;padding:12px 18px;background-color:#02080d;}
.dialogue-frame{position:absolute;top:0px;left:0px;width:432px;height:228px;}
.speaker-row{height:30px;justify-content:space-between;align-items:center;}
.speaker{font-size:23px;color:#ffffff;}
.chapter{font-size:15px;color:#82b2c2;}
.dialogue-scroll{width:396px;height:128px;flex-direction:column;}
.dialogue{width:396px;flex-shrink:0;lines:-1;color:#ffffff;line-height:34px;text-align:left;}
.toolbar{padding:0px 14px;height:42px;width:396px;justify-content:space-between;align-items:center;}
.tool{font-size:19px;color:#8bdae1;padding:8px;}
.game-title{font-size:28px;color:#6be1e9;text-align:left;margin-bottom:12px;}
.subtitle{font-size:20px;color:#89a8b5;text-align:left;margin-bottom:24px;}
.action{height:52px;width:356px;margin-bottom:8px;color:#030e16;background-color:#2494a3;text-align:center;font-size:24px;}
.choice-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;background-color:#02080d;flex-direction:column;padding:24px 18px;}
.choice-title{padding-left:22px;height:44px;font-size:25px;color:#6be1e9;margin-bottom:14px;text-align:left;}
.choice-list{width:396px;height:370px;flex-direction:column;}
.choice-row{height:108px;width:396px;margin-bottom:10px;}
.choice-surface{position:absolute;top:0px;left:0px;height:108px;width:396px;}
.choice{height:108px;width:396px;padding:16px;font-size:24px;line-height:32px;color:#ffffff;text-align:left;}
.small-action{height:38px;font-size:20px;color:#6be1e9;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:28px 40px;}
.menu-title{height:40px;font-size:28px;color:#6be1e9;text-align:left;margin-bottom:12px;}
.menu-action{height:50px;font-size:22px;color:#020e15;background-color:#2494a3;margin-bottom:8px;text-align:center;}
.reading-menu{padding:0px;}
.quick-title{position:absolute;top:28px;left:40px;height:34px;width:352px;font-size:26px;color:#6be1e9;}
.quick-subtitle{position:absolute;top:62px;left:40px;height:22px;width:352px;font-size:15px;color:#8ea8b7;}
.quick-grid{position:absolute;top:90px;left:18px;width:396px;height:280px;flex-direction:column;}
.quick-row{width:396px;height:60px;margin-bottom:10px;justify-content:space-between;}
.quick-cell{width:192px;height:60px;}
.quick-card{position:absolute;top:0px;left:0px;width:192px;height:60px;}
.quick-action{width:192px;height:60px;padding:10px 14px;font-size:18px;line-height:24px;color:#e1f6fc;text-align:left;}
.quick-resume{position:absolute;top:384px;left:18px;width:396px;height:48px;}
.quick-title-return{position:absolute;top:442px;left:18px;width:396px;height:42px;}
.muted{color:#7ac8d4;background-color:#0b2330;border-width:1px;border-color:#1c596c;}
.settings-panel{padding:0px;}
.settings-title{position:absolute;top:28px;left:40px;height:36px;width:352px;font-size:28px;color:#6be1e9;}
.settings-subtitle{position:absolute;top:64px;left:40px;height:22px;width:352px;font-size:15px;color:#8ea8b7;}
.settings-speed{position:absolute;top:94px;left:18px;width:396px;height:44px;font-size:20px;}
.settings-font{position:absolute;top:148px;left:18px;width:396px;height:44px;font-size:20px;}
